ALLOWED_CATEGORIES = {"tutorial", "guide", "reference", "explanation"}
ALLOWED_LEVELS = {"basic", "intermediate", "advanced"}
PART_RE = re.compile(r"-part(\d+)\.md$", re.IGNORECASE)

MAX_NAV_ITEMS_PER_SECTION = 7

DIATAXIS_INDEX_DIR = "categories"

DIATAXIS_TYPES: Dict[str, Dict[str, str]] = {
    "tutorial": {
        "slug": "tutorial",
        "label": "Tutorials",
        "description": (
            "Learn CiviCRM through guided, practical lessons. "
